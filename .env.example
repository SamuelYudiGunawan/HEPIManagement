PORT=3000
TZ=Asia/Jakarta
PUBLIC_ORIGIN=http://localhost:3000
PUBLIC_HTTPS=false

# management.hepiproperty.com currently goes directly to the origin, with no CDN.
# Keep this empty unless a proxy is confirmed and direct origin access is restricted.
TRUST_PROXY_CIDRS=

# Data storage for Activity and Attendance. Keep "sheets" until the MySQL
# tables have been imported and row counts have been reconciled.
ACTIVITY_STORAGE=sheets
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECTION_LIMIT=5
MYSQL_SSL=false

# Encrypted offsite backups. Keep the private key only on a trusted computer;
# the hosting app only needs the public key and an unshared Drive folder ID.
ACTIVITY_BACKUP_FOLDER_ID=
ACTIVITY_BACKUP_PUBLIC_KEY_B64=

# Weekly Wednesday meeting attendance (Wi-Fi IP check can be turned off if
# the office ISP changes its public IP; the server-side location check stays on)
ATTENDANCE_OFFICE_IPS=182.253.58.67
ATTENDANCE_REQUIRE_OFFICE_IP=true
ATTENDANCE_OFFICE_LAT=-6.95825392528478
ATTENDANCE_OFFICE_LON=110.40835301778183
ATTENDANCE_RADIUS_METERS=50

# Spreadsheet ID from the Google Sheets URL (not in the old GAS repo)
GOOGLE_SHEETS_ID=

# Drive root folder that holds month folders / listings, and (under a
# "FORM LISTING" subfolder created automatically) the Form Listing queue
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Auth: pick ONE of the two options below ---

# Option A (personal Gmail — no Google Workspace): OAuth as a real Google
# account, so Drive/Sheets writes use that account's own storage quota
# (same as the old GAS script). Generate these with:
#   node scripts/oauth-authorize.js
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Option B (Google Workspace only): a service account. Do NOT paste the
# JSON into hPanel / CloudLinux env vars — bash export breaks on the
# private key and the Node wrapper dies (503). Upload service-account.json
# next to server.js instead. Requires the target folders to live inside a
# Shared Drive — a bare service account has no storage quota of its own.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- End-user Sign-in with Google (replaces agent-code/PIN login) ---
# Separate OAuth Client from GOOGLE_OAUTH_CLIENT_ID above (that one is for the
# server's own Sheets/Drive quota; this one authenticates agents in the
# browser). Create at console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID > Web application. Add both the local and
# production callback URL below as "Authorized redirect URIs" on that client.
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Random 32+ byte secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret token for cPanel cron. Prefer the X-Cron-Token request header.
CRON_SECRET=

# Optional: milliseconds for one import batch (stay under host timeout)
IMPORT_MAX_MS=45000

# Web Push (browser notifications for agents/adminkantor). Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Must be the SAME keys on every server that sends push — changing them
# invalidates every agent's existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hidupelsepropertyindonesia@gmail.com
