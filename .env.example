PORT=3000
TZ=Asia/Jakarta

# Spreadsheet ID from the Google Sheets URL (not in the old GAS repo)
GOOGLE_SHEETS_ID=

# Drive root folder that holds month folders / listings
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Separate Drive root folder for the Form Listing review queue
# (ROOT -> Bulan Tahun -> Kode Agen -> Date -> files). Optional: the
# /form-listing pages just 503 until this is set.
GOOGLE_DRIVE_FORM_LISTING_ROOT_FOLDER_ID=

# Do NOT paste the JSON into hPanel / CloudLinux env vars — bash export
# breaks on the private key and the Node wrapper dies (503).
# Upload service-account.json next to server.js, then:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Secret token for cPanel cron: GET /api/cron/import?token=...
CRON_SECRET=change-me

# Optional: milliseconds for one import batch (stay under host timeout)
IMPORT_MAX_MS=45000
