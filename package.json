{
  "name": "hepi-listings",
  "version": "1.0.0",
  "private": true,
  "description": "HEPI Property Listings — Node.js Fastify website (Google Sheets/Drive and optional MySQL activity storage)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate:activity": "node --disable-wasm-trap-handler scripts/migrate-activity-to-mysql.js",
    "migrate:activity:import": "node --disable-wasm-trap-handler scripts/migrate-activity-to-mysql.js --import",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "googleapis": "^144.0.0",
    "mysql2": "^3.24.6",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
